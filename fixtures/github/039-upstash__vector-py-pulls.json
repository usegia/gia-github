      {
        "id": 2145349855,
        "node_id": "PR_kwDOLBN4sM5_33Df",
        "number": 35,
        "state": "closed",
        "title": "Do not retry in case of an nginx timeout error",
        "body": "When the client request timeouts, the nginx returns an HTML error page.\r\n\r\nWe should not retry when that happens (which would fail the respone.json() call as it is not a json).\r\n\r\nThis PR pulls the parsing of the response body out of the retry logic.",
        "html_url": "https://github.com/upstash/vector-py/pull/35",
        "created_at": "2024-10-25T08:50:46Z",
        "updated_at": "2024-10-25T09:07:32Z",
        "closed_at": "2024-10-25T09:07:29Z",
