      {
        "id": 2246148609,
        "node_id": "PR_kwDOLBN4sM6F4YIB",
        "number": 38,
        "state": "closed",
        "title": "Increase http read/write timeout",
        "body": "We saw that during upsert of large batches, index might fail to answer in 2 minutes if it is performing indexing in the background.\r\n\r\nTherefore, I am bumping the http timeout to 10 minutes until we make it faster on the backend.",
