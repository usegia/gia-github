      {
        "id": 4407502009,
        "node_id": "PR_kwDOQ6ulRs8AAAABBrUkuQ",
        "number": 275,
        "state": "closed",
        "title": "Make decouple/merge stay in lockstep with the generators",
        "body": "Currently an underlying generator passed to merge can get up to three\nelements ahead of the consumer, with elements buffered:\n * one in the decouple queue\n * one blocked on queue.put in decouple\n * one buffered in the anext task in merge, created before the yield\n\nModify decouple to use a semaphore so that the decoupled producer\nstill runs in lockstep with the consumer and make merge only launch a\nnew task once back from yielding.\n\nShouldn't be any major practical impacts of this change.\n",
        "html_url": "https://github.com/vercel-labs/ai-python/pull/275",
        "created_at": "2026-09-01T00:26:29Z",
        "updated_at": "2026-09-01T17:26:11Z",
